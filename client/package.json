  "dependencies": {
    "@expo/ui": "~56.0.16",
    "expo": "56.0.9",
    "expo-constants": "~56.0.17",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.10",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "posthog-js": "1.447.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "prestart": "node --experimental-strip-types ./scripts/sync-date-filters.ts",
    "preweb": "node --experimental-strip-types ./scripts/sync-date-filters.ts",
    "preios": "node --experimental-strip-types ./scripts/sync-date-filters.ts",
    "preandroid": "node --experimental-strip-types ./scripts/sync-date-filters.ts",
    "pretypecheck": "node --experimental-strip-types ./scripts/sync-date-filters.ts",
    "prebuild": "node --experimental-strip-types ./scripts/sync-date-filters.ts",
    "build": "expo export --platform web --clear && node --experimental-strip-types ./scripts/configure-web-output.ts"
  },
  "private": true,
  "overrides": {
    "@expo/cli": "56.1.15"
  },
  "engines": {
    "node": ">=22.16.0"
