# Configure these values for your deployment; never commit credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PUBLIC_BASE_URL=http://localhost:3000
IMAGE_DIR=
PORT=3000
# Optional; server-side only. Use a strong random token and HTTPS outside local development.
# Omit entirely to disable administrative endpoints.
ADMIN_TOKEN=
# Optional: configure both to enable web user authentication. Allow only trusted app origins.
GOOGLE_CLIENT_ID=
AUTH_ORIGINS=
