{
  "name": "dracula-seeker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node dist/central-server.js",
    "start:hosted": "node dist/hosted-server.js",
    "dev": "node scripts/dev.mjs",
    "dev:server:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:central": "node --watch dist/central-server.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "commit:push": "bash scripts/commit-push.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p database/tsconfig.json && tsc --noEmit -p sources/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "jsonwebtoken": "9.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
